# Any OpenAI-compatible inference endpoint (OpenAI itself, OpenRouter, Groq,
# Together, a local vLLM/Ollama server, etc). Copy to .env.local and fill in.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Supabase project (Settings -> API in the Supabase dashboard). Server-only —
# no client-side Supabase code exists yet, so no NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Agent tools — optional. A missing key just omits that tool from the model's
# tool list for the request (no error), so the app works without these too.
# Web search for the Research/Auto/Code agents: https://app.tavily.com (free tier)
TAVILY_API_KEY=
# Sandboxed code execution for the Code/Data agents: https://e2b.dev (free tier
# covers dev and early usage). This is Rechatta's own key, billed to this app's
# account — never a per-user key; each runCode call spins up one sandbox and
# kills it immediately after, so cost tracks actual compute, not idle time.
E2B_API_KEY=